# Application
APP_NAME="dMRV PayGo"
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Database
DATABASE_URL=postgresql://dmrv_user:dmrv_pass@localhost:5432/dmrv_paygo

# M-Pesa (Safaricom Daraja API)
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-mpesa-passkey
MPESA_CALLBACK_URL=https://yourdomain.com/api/v1/payments/mpesa/callback
MPESA_ENV=sandbox

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_ENV=sandbox

# Flutterwave
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-public-key
FLUTTERWAVE_WEBHOOK_SECRET=your-flutterwave-webhook-secret
FLUTTERWAVE_REDIRECT_URL=https://yourdomain.com/api/v1/payments/flutterwave/callback

# PayGo Pricing (USD per unit)
PRICE_PER_MEASUREMENT=0.10
PRICE_PER_VERIFICATION=0.50
PRICE_PER_REPORT=1.00
FREE_TIER_MEASUREMENTS=50
